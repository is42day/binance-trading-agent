# Environment variables for Binance Trading Agent
# Copy this file to .env and update with your actual values

# Binance API Configuration
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_secret_key_here
BINANCE_API_URL=https://testnet.binance.vision
BINANCE_TESTNET=true
ALLOW_LIVE_TRADING=false
DEMO_MODE=false

# Database Configuration
# For Docker/Production: Use PostgreSQL (recommended)
DATABASE_URL=postgresql+psycopg2://trading_user:trading_pass_CHANGE_ME@postgres:5432/binance_trading

# For local development: Use SQLite (fallback if DATABASE_URL not set)
DB_PATH=/app/data/portfolio.db

# PostgreSQL Connection Pool Settings (optional, defaults shown)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# PostgreSQL Database Credentials (for docker-compose)
POSTGRES_DB=binance_trading
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=replace_with_a_long_random_database_password

# MCP Server Configuration
MCP_SERVER_PORT=8080
MCP_SERVER_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5

# Monitoring Configuration (optional)
GRAFANA_PASSWORD=admin123

# Trading Configuration
PORTFOLIO_DATABASE=/app/data/portfolio.db  # Deprecated: use DATABASE_URL or DB_PATH
MAX_TRADE_AMOUNT=1000.0
RISK_PERCENTAGE=2.0
EMERGENCY_STOP=false
RISK_SHARED_STATE_ENABLED=true  # Persist emergency stop across API/dashboard/trading-agent processes
PORTFOLIO_INITIAL_VALUE=5000.0
RISK_MAX_TOTAL_EXPOSURE=0.30        # Hard cap: no more than 30% deployed
RISK_MAX_POSITION_PER_SYMBOL=0.08   # Hard cap: no more than 8% per symbol
RISK_MAX_SINGLE_TRADE_SIZE=0.05     # Hard cap: no more than 5% per order
RISK_MAX_OPEN_POSITIONS=4
RISK_MAX_DAILY_DRAWDOWN=0.01        # Pause/reject new trades after 1% daily drawdown
RISK_MAX_TOTAL_DRAWDOWN=0.05        # Pause/reject new trades after 5% peak drawdown
TRADING_SYMBOLS=BTCUSDT
TRADING_INTERVAL_SECONDS=120
TRADING_DURATION_MINUTES=0
STRATEGY_NAME=combined
DASHBOARD_DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT
EXCHANGE_RECONCILE_ON_START=true
EXCHANGE_RECONCILE_REQUIRED=true

# Signal Generation Settings
# TESTNET_AGGRESSIVE_MODE: Set true ONLY for testnet pipeline testing
# WARNING: When true, converts all HOLD signals to random BUY/SELL - never use in production!
TESTNET_AGGRESSIVE_MODE=false

# RSI Thresholds
# Production (recommended): 70/30 - conservative, high-quality signals
# Aggressive: 65/35 - more signals, higher risk
# Testnet testing: 55/45 - very frequent signals for testing
SIGNAL_RSI_OVERBOUGHT=70
SIGNAL_RSI_OVERSOLD=30

# Test mode - forces random signals always (for integration testing only)
SIGNAL_AGENT_TEST_MODE=false

# Security (for production)
API_AUTH_REQUIRED=true
API_AUTH_TOKEN=replace_with_a_long_random_api_token
API_CORS_ORIGINS=http://localhost:8050,http://127.0.0.1:8050
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace_with_a_long_random_dashboard_password
DASHBOARD_BIND_ADDRESS=0.0.0.0
DASHBOARD_PORT=8050
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
MCP_BIND_ADDRESS=127.0.0.1
MCP_HOST_PORT=8081
